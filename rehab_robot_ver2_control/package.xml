<?xml version="1.0"?>
<package format="3">
  <name>rehab_robot_ver2_control</name>
  <version>0.0.1</version>
  <description>Control node for the rehabilitation robot, integrating KDL kinematics and RViz custom plugin messages.</description>

  <maintainer email="dat@example.com">Đạt</maintainer>
  <license>MIT</license>

  <!-- ========================= -->
  <!-- Build tools -->
  <!-- ========================= -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ========================= -->
  <!-- Build dependencies -->
  <!-- ========================= -->
  <build_depend>rclcpp</build_depend>
  <build_depend>orocos_kdl</build_depend>
  <build_depend>urdf</build_depend>
  <build_depend>kdl_parser</build_depend>
  <build_depend>rviz_custom_plugins</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>ament_index_cpp</build_depend>
  <build_depend>rviz_common</build_depend>
  <build_depend>rviz_rendering</build_depend>
  <build_depend>rviz_default_plugins</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>

  <!-- ========================= -->
  <!-- Execution dependencies -->
  <!-- ========================= -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>orocos_kdl</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>kdl_parser</exec_depend>
  <exec_depend>rviz_custom_plugins</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ament_index_cpp</exec_depend>
  <exec_depend>rviz_common</exec_depend>
  <exec_depend>rviz_rendering</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>

  <!-- Qt dependency (for GUI integration if needed) -->
  <exec_depend>qtbase5-dev</exec_depend>

  <!-- ========================= -->
  <!-- Test dependencies -->
  <!-- ========================= -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- ========================= -->
  <!-- Export -->
  <!-- ========================= -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
